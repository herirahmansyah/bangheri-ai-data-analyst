# Copy this file to .env.local for local development.
# Never commit real secrets. Placeholder values only.

# Server port (defaults to 3000 when unset). Must be an integer 1-65535.
PORT=3000

# development | production
NODE_ENV=development

# BYOK (Bring Your Own Key): users paste their own Gemini API key in the UI
# header. It is held ONLY in browser memory, sent per-request via the
# `x-gemini-api-key` header, and NEVER stored on the server. There is no
# server-side GEMINI_API_KEY — do not set one here.

# Public base URL of THIS server, used by sandbox scripts that need to reach
# back into the app (e.g. GCS downloads). MUST be an absolute https:// URL in
# production (fail-closed). For local development you may leave it empty and a
# safe http://localhost:<PORT> fallback is used. Never derive it from client
# headers.
PUBLIC_BASE_URL=

# Optional daily quota limit (integer). Leave empty for the default.
DAILY_QUOTA_LIMIT=
